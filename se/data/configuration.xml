<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!--
		# se build

		## Configuration options

			- `max-cache-size`

				Type: A size string, like `50MB`, or an empty string.

				Default: 50MB

				Description:

					Defines the maximum size of the local build cache. If the cache grows beyond this size, the oldest cached items are removed until the cache is below this size. `se build` may create a cache entry that temporarily pushes the cache size above this value before the cache is pruned at the end of the build process.

					If this value is not set, the default value is used. If this value is set to an empty string, the cache size is defined as unlimited.
	-->
	<build
		max-cache-size="50MB"
	/>

	<!--
		# se create-draft

		## Configuration options

			- `default-email`

				Type: An email address.

				Default: Empty string.

				Description:

					Defines the default email address used to initialize the Git repository of the draft.

					If this value is not set or is set to an empty string, the Git repository is initialized using your local Git configuration values.

			- Placeholder attributes

				Type: A string.

				Default: Not set.

				Description:

					Each placeholder in a new draft has a corresponding lowercase, hyphenated attribute in this configuration, e.g. `PRODUCER_NAME` => `producer-name`. If an attribute matching a placeholder is present in this configuration, its value replaces the corresponding placeholder in the draft. For example, `producer-name="John Doe"` in this configuration will replace `PRODUCER_NAME` with `John Doe` in the draft.
	-->
	<create-draft
		default-email=""
		lang="LANG"
		producer-name="PRODUCER_NAME"
		producer-sort="PRODUCER_SORT"
		producer-url="PRODUCER_URL"
		publisher-name="PUBLISHER_NAME"
		publisher-sort="PUBLISHER_SORT"
		publisher-url="PUBLISHER_URL"
	/>
</configuration>
